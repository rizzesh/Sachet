# LLM Provider Configuration (used for dataset generation & baseline evaluation)
# Options: "gemini", "openai", "groq"
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-1.5-flash

# Sachet FastAPI Service Configuration
SACHET_API_KEY=sachet_demo_secret_2027
HOST=0.0.0.0
PORT=8000

# Session Management
SESSION_EXPIRY_MINUTES=30

# ── Hugging Face Spaces Deployment ──────────────────────────────────────────
# Repo ID of your fine-tuned model on HF Hub (e.g. "your-username/sachet-muril-v2")
# The API will auto-download this if the local model path doesn't exist.
HF_MODEL_REPO=your-hf-username/sachet-muril-v2

# HF access token (only needed if the model repo is PRIVATE)
# Generate at https://huggingface.co/settings/tokens (type: "read")
HF_TOKEN=

# Set to "true" on Render free tier (uses HF Serverless Inference instead of loading 1GB model in RAM)
USE_HF_INFERENCE=false
